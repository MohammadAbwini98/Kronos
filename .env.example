# .env.example
# Never commit real secrets. Copy this file to .env and fill only local values.

# Capital.com credentials
CAPITAL_ENV=demo
CAPITAL_API_KEY=
CAPITAL_EMAIL=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_ACCOUNT_ID=
CAPITAL_USE_ENCRYPTED_PASSWORD=false
CAPITAL_API_BASE_URL=https://demo-api-capital.backend-capital.com/api/v1
CAPITAL_DEMO_ACCOUNT_NAME=DEMOAI

# PostgreSQL
# POSTGRES_DSN takes precedence when set. DB_* values are also supported.
POSTGRES_DSN=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goldbot
DB_USER=
DB_PASSWORD=
POSTGRES_SCHEMA=gold_manual

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Active trading instrument
TRADING_INSTRUMENT_NAME=Gold
TRADING_BASE_ASSET=XAU
TRADING_QUOTE_ASSET=USD
TRADING_DISPLAY_SYMBOL=XAU/USD
TRADING_PROVIDER_SYMBOL=GOLD
TRADING_DATABASE_SCHEMA=gold_manual
TRADING_CANDLE_INTERVAL=MINUTE_5
TRADING_PRICE_PRECISION=2
TRADING_VOLUME_PRECISION=2
TRADING_TICK_SIZE=0.01
TRADING_PIP_SIZE=0.01
TRADING_MAX_CANDLE_MOVE_PCT=5.0

# Capital.com market/data defaults
CAPITAL_DEFAULT_MARKET_SEARCH=XAUUSD
CAPITAL_DEFAULT_EPIC=GOLD
CAPITAL_DEFAULT_RESOLUTION=MINUTE_5
CAPITAL_DEFAULT_PRICE_SIDE=mid
CAPITAL_OUTPUT_DIR=output
CAPITAL_DISPLAY_TIMEZONE=Asia/Amman

# Optional AI model stack
AI_MODELS_ENABLED=false
AI_MODELS_CONFIG=configs/models.example.yaml

# Signal generation
SIGNAL_SYMBOL=XAUUSD
SIGNAL_RESOLUTION=MINUTE_5
SIGNAL_INTERVAL_MINUTES=5
SIGNAL_LOOKBACK=512
SIGNAL_PRED_LEN=12
SIGNAL_COST_THRESHOLD_PCT=0.05
SIGNAL_FLAT_THRESHOLD_PCT=0.02
SIGNAL_MIN_CONFIDENCE=0.55

# Signal validation
SIGNAL_VALIDATION_ENABLED=true
SIGNAL_VALIDATION_STRICT=false
SIGNAL_VALIDATION_TIMEFRAMES=MINUTE_15,MINUTE_30,HOUR
SIGNAL_REQUIRE_HOUR_CONFIRMATION=false
SIGNAL_BLOCK_ON_DIRECTION_REGIME_CONFLICT=true
SIGNAL_STRONG_DISAGREEMENT_TREND_STRENGTH=20
SIGNAL_BLOCK_ON_EXTREME_VOLATILITY=true
SIGNAL_BLOCK_ON_WIDE_SPREAD=true
SIGNAL_BLOCK_ON_LOW_VOLUME=false
SIGNAL_MAX_SPREAD_PCT=0.12
SIGNAL_MIN_NET_EDGE_PCT=0.05
SIGNAL_SCORE_STRONG_THRESHOLD=85
SIGNAL_SCORE_ACTIONABLE_THRESHOLD=70
SIGNAL_SCORE_WEAK_THRESHOLD=60
SIGNAL_SCORE_WATCH_THRESHOLD=50
SIGNAL_ATR_EXTREME_PERCENTILE=95
SIGNAL_LOW_VOLUME_ZSCORE=-1.0
SIGNAL_LOW_VOLUME_PENALTY_POINTS=3.0

# Trade execution, disabled by default
AUTO_EXECUTE_SIGNALS=false
DEFAULT_TRADE_SIZE=0.05
MAX_CONCURRENT_OPEN_TRADES=1
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS=0
TRADE_PRICE_TOLERANCE=0.1
TRADE_SIGNAL_STALE_MINUTES=30
TRADE_EXECUTION_QUEUE_CONCURRENCY=1

# Kronos model paths and inference
KRONOS_REPO_DIR=.\KRONOS-MODEL
KRONOS_MODEL_DIR=.\KRONOS-MODEL\model\Kronos-base
KRONOS_TOKENIZER_DIR=.\KRONOS-MODEL\model\Kronos-Tokenizer-base
KRONOS_DEVICE=auto
KRONOS_INFERENCE_TEMPERATURE=0.65
KRONOS_INFERENCE_TOP_P=0.75
KRONOS_INFERENCE_SAMPLE_COUNT=3

# Workers and maintenance
ENABLE_AUTO_FINETUNE=false
ENABLE_SHADOW_MODEL=false
ENABLE_MAINTENANCE_WORKER=true
ENABLE_HISTORICAL_5M_BACKFILL=true
HISTORICAL_BACKFILL_RESOLUTION=MINUTE_5
HISTORICAL_BACKFILL_DAYS=35
HISTORICAL_BACKFILL_INTERVAL_MINUTES=5
HISTORICAL_BACKFILL_CHUNK_POINTS=900
LIVE_PRICE_RESOLUTION=MINUTE_5
WORKER_RESTART_MAX_ATTEMPTS=20
WORKER_MONITOR_INTERVAL_SECONDS=5

# Optional auto-finetune command
KRONOS_FINETUNE_COMMAND=
KRONOS_AUTO_MODEL_DIR=.\KRONOS-MODEL\model\Kronos-auto-finetuned
AUTO_FINETUNE_DATASET_LIMIT=12000
AUTO_FINETUNE_MIN_ROWS=2000
AUTO_FINETUNE_MIN_NEW_ROWS=500
AUTO_FINETUNE_INTERVAL_MINUTES=60
AUTO_FINETUNE_FAILURE_COOLDOWN_MINUTES=360
AUTO_FINETUNE_TRAINING_HEARTBEAT_SECONDS=60
AUTO_FINETUNE_PROMOTION_MIN_DIRECTION_ACCURACY=55.0
AUTO_FINETUNE_PROMOTION_MIN_MATCHED_CANDLES=20
KRONOS_AUTOFINETUNE_BASEMODEL_EPOCHS=3
KRONOS_AUTOFINETUNE_BATCH_SIZE=8
KRONOS_AUTOFINETUNE_LEARNING_RATE=0.00001
KRONOS_AUTOFINETUNE_NUM_WORKERS=0
KRONOS_AUTOFINETUNE_DEVICE=auto
KRONOS_AUTOFINETUNE_TIMEOUT_MINUTES=180

# Maintenance and logs
MAINTENANCE_POLL_SECONDS=60
OUTCOME_ARCHIVE_RETENTION_DAYS=30
OUTCOME_ARCHIVE_INTERVAL_MINUTES=60
NIGHTLY_BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14
CAPITAL_LOG_DIR=logs
CAPITAL_LOG_MAX_BYTES=5242880
CAPITAL_LOG_BACKUP_COUNT=5
